# Never commit real values. Generate passwords interactively when creating users.
# Elige exactamente un perfil. Smoke local permite HTTP; producción exige HTTPS.
OPTIONS_SCANNER_ENV=production
OPTIONS_SCANNER_DB=/var/lib/options-scanner/beta.sqlite3
OPTIONS_SCANNER_SECURE_COOKIES=1
OPTIONS_SCANNER_PUBLIC_URL=https://beta.example.com
OPTIONS_SCANNER_SESSION_SECONDS=28800
OPTIONS_SCANNER_HOST=127.0.0.1
OPTIONS_SCANNER_PORT=8000
OPTIONS_SCANNER_LIVE_ENABLED=0
OPTIONS_SCANNER_IBKR_BASE_URL=https://localhost:5000/v1/api
